@model PlataformaCreditos.Models.SolicitudCredito

@{
    ViewData["Title"] = "Nueva Solicitud de Crédito";
}

<h2 class="mb-4">Registrar Nueva Solicitud de Crédito</h2>

@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["MensajeExito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <form asp-action="Crear" method="post">
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="MontoSolicitado" class="form-label">Monto Solicitado</label>
                        <input asp-for="MontoSolicitado" class="form-control" type="number" step="0.01" placeholder="Ej. 2500.00" />
                        <span asp-validation-for="MontoSolicitado" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="MisSolicitudes" class="btn btn-secondary">Volver a Mis Solicitudes</a>
                        <button type="submit" class="btn btn-primary">Enviar Solicitud</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>