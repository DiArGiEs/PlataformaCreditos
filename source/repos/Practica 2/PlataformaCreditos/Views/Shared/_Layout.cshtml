<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PlataformaCreditos</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PlataformaCreditos.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">PlataformaCreditos</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <!-- Menú disponible para Clientes y Usuarios Autenticados -->
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Solicitudes" asp-action="MisSolicitudes">Mis Solicitudes</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Solicitudes" asp-action="Crear">Nueva Solicitud</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Notificaciones" asp-action="MisNotificaciones">Mis Notificaciones</a>
                            </li>

                            @if (User.IsInRole("Analista"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-danger fw-bold" asp-controller="Analista" asp-action="Index">Panel Analista</a>
                                </li>
                            }
                        }
                    </ul>

                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <!-- Indicador visual del estado de conexión WebSocket -->
                        <div class="me-3 d-flex align-items-center">
                            <span id="wsStatusBadge" class="badge bg-secondary">WS: Conectando...</span>
                        </div>
                    }

                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <!-- Notificación global en tiempo real vía WebSocket -->
        <div id="wsAlertBox" class="alert alert-info alert-dismissible fade show d-none" role="alert">
            <span id="wsAlertMessage"></span>
            <button type="button" class="btn-close" onclick="document.getElementById('wsAlertBox').classList.add('d-none')"></button>
        </div>

        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; @DateTime.Now.Year - PlataformaCreditos
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <!-- Cliente JS SignalR / WebSocket -->
        <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
        <script>
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/hubs/solicitudes")
                .withAutomaticReconnect()
                .build();

            const statusBadge = document.getElementById("wsStatusBadge");
            const alertBox = document.getElementById("wsAlertBox");
            const alertMessage = document.getElementById("wsAlertMessage");

            connection.onreconnecting(() => {
                if (statusBadge) {
                    statusBadge.className = "badge bg-warning text-dark";
                    statusBadge.innerText = "WS: Reconectando...";
                }
            });

            connection.onreconnected(() => {
                if (statusBadge) {
                    statusBadge.className = "badge bg-success";
                    statusBadge.innerText = "WS: Conectado";
                }
            });

            connection.on("SolicitudEstadoActualizado", (data) => {
                if (alertBox && alertMessage) {
                    alertBox.classList.remove("d-none");
                    let msg = `<strong>¡Notificación en tiempo real!</strong> Tu solicitud #${data.solicitudId} cambió a estado: <strong>${data.estado}</strong>.`;
                    if (data.motivoRechazo) {
                        msg += ` Motivo: ${data.motivoRechazo}`;
                    }
                    alertMessage.innerHTML = msg;
                }

                const celdaEstado = document.getElementById(`estado-solicitud-${data.solicitudId}`);
                if (celdaEstado) {
                    celdaEstado.innerText = data.estado;
                }
            });

            connection.start()
                .then(() => {
                    if (statusBadge) {
                        statusBadge.className = "badge bg-success";
                        statusBadge.innerText = "WS: Conectado";
                    }
                })
                .catch(err => {
                    if (statusBadge) {
                        statusBadge.className = "badge bg-danger";
                        statusBadge.innerText = "WS: Desconectado";
                    }
                    console.error("Error al conectar WebSocket:", err.toString());
                });
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>